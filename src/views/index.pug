// ==============================================================
// Main wrapper - style you can find in pages.scss
// ==============================================================
#main-wrapper(data-theme='light' data-layout='vertical' data-navbarbg='skin6' data-sidebartype='full' data-sidebar-position='fixed' data-header-position='fixed' data-boxed-layout='full')
  // ==============================================================
  // Topbar header - style you can find in pages.scss
  // ==============================================================
  header.topbar(data-navbarbg='skin6')
    nav.navbar.top-navbar.navbar-expand-md
      .navbar-header(data-logobg='skin6')
        // This is for the sidebar toggle which is visible on mobile only
        a.nav-toggler.waves-effect.waves-light.d-block.d-md-none(href='javascript:void(0)')
          i.ti-menu.ti-close
        // ==============================================================
        // Logo
        // ==============================================================
        .navbar-brand
          // Logo icon
          a.tw-h-full.tw-py-4.tw-w-full(href='/admin' class='!tw-block')
            img.dark-logo.tw-h-full.tw-w-full.tw-object-contain(src='/assets/images/logo.png' alt='homepage' class='!tw-block')
        // ==============================================================
        // End Logo
        // ==============================================================
        // ==============================================================
        // Toggle which is visible on mobile only
        // ==============================================================
        a.topbartoggler.d-block.d-md-none.waves-effect.waves-light(href='javascript:void(0)' data-toggle='collapse' data-target='#navbarSupportedContent' aria-controls='navbarSupportedContent' aria-expanded='false' aria-label='Toggle navigation')
          i.ti-more
      // ==============================================================
      // End Logo
      // ==============================================================
      #navbarSupportedContent.navbar-collapse.collapse
        // ==============================================================
        // toggle and nav items
        // ==============================================================
        ul.navbar-nav.float-left.mr-auto.ml-3.pl-1
          // Notification
          li.nav-item.dropdown
            a#bell.nav-link.dropdown-toggle.pl-md-3.position-relative(href='javascript:void(0)' role='button' data-toggle='dropdown' aria-haspopup='true' aria-expanded='false')
              span
                i.svg-icon(data-feather='bell')
              span.badge.badge-primary.notify-no.rounded-circle 5
            .dropdown-menu.dropdown-menu-left.mailbox.animated.bounceInDown
              ul.list-style-none
                li
                  .message-center.notifications.position-relative
                    // Message
                    a.message-item.d-flex.align-items-center.border-bottom.px-3.py-2(href='javascript:void(0)')
                      .btn.btn-danger.rounded-circle.btn-circle
                        i.text-white(data-feather='airplay')
                      .w-75.d-inline-block.v-middle.pl-2
                        h6.message-title.mb-0.mt-1
                          | Luanch Admin
                        span.font-12.text-nowrap.d-block.text-muted Just see the my new admin!
                        span.font-12.text-nowrap.d-block.text-muted 9:30 AM
                    // Message
                    a.message-item.d-flex.align-items-center.border-bottom.px-3.py-2(href='javascript:void(0)')
                      span.btn.btn-success.text-white.rounded-circle.btn-circle
                        i.text-white(data-feather='calendar')
                      .w-75.d-inline-block.v-middle.pl-2
                        h6.message-title.mb-0.mt-1 Event today
                        span.font-12.text-nowrap.d-block.text-muted.text-truncate Just a reminder that you have event
                        span.font-12.text-nowrap.d-block.text-muted 9:10 AM
                    // Message
                    a.message-item.d-flex.align-items-center.border-bottom.px-3.py-2(href='javascript:void(0)')
                      span.btn.btn-info.rounded-circle.btn-circle
                        i.text-white(data-feather='settings')
                      .w-75.d-inline-block.v-middle.pl-2
                        h6.message-title.mb-0.mt-1 Settings
                        span.font-12.text-nowrap.d-block.text-muted.text-truncate You can customize this template as you want
                        span.font-12.text-nowrap.d-block.text-muted 9:08 AM
                    // Message
                    a.message-item.d-flex.align-items-center.border-bottom.px-3.py-2(href='javascript:void(0)')
                      span.btn.btn-primary.rounded-circle.btn-circle
                        i.text-white(data-feather='box')
                      .w-75.d-inline-block.v-middle.pl-2
                        h6.message-title.mb-0.mt-1 Pavan kumar
                        span.font-12.text-nowrap.d-block.text-muted Just see the my admin!
                        span.font-12.text-nowrap.d-block.text-muted 9:02 AM
                li
                  a.nav-link.pt-3.text-center.text-dark(href='javascript:void(0);')
                    strong Check all notifications
                    i.fa.fa-angle-right
          // End Notification
          // ==============================================================
          // create new
          // ==============================================================
          li.nav-item.dropdown
            a#navbarDropdown.nav-link.dropdown-toggle(href='#' role='button' data-toggle='dropdown' aria-haspopup='true' aria-expanded='false')
              i.svg-icon(data-feather='settings')
            .dropdown-menu(aria-labelledby='navbarDropdown')
              a.dropdown-item(href='#') Action
              a.dropdown-item(href='#') Another action
              .dropdown-divider
              a.dropdown-item(href='#') Something else here
        // ==============================================================
        // Right side toggle and nav items
        // ==============================================================
        ul.navbar-nav.float-right
          // ==============================================================
          // Search
          // ==============================================================
          li.nav-item.d-none.d-md-block
            a.nav-link(href='javascript:void(0)')
              form
                .customize-input
                  input.form-control.custom-shadow.custom-radius.border-0.bg-white(type='search' placeholder='Tìm kiếm' aria-label='Search')
                  i.form-control-icon(data-feather='search')
          // ==============================================================
          // User profile and search
          // ==============================================================
          li.nav-item.dropdown
            a.nav-link.dropdown-toggle(href='javascript:void(0)' data-toggle='dropdown' aria-haspopup='true' aria-expanded='false')
              img.rounded-circle(src='/assets/images/users/profile-pic.jpg' alt='user' width='40')
              span.ml-2.d-none.d-lg-inline-block
                span Xin ch&agrave;o,
                span.text-dark Admin
                i.svg-icon(data-feather='chevron-down')
            .dropdown-menu.dropdown-menu-right.user-dd.animated.flipInY
              a.dropdown-item(href='update-profile.html')
                i.svg-icon.mr-2.ml-1(data-feather='user')
                |  My
                |                     Profile
              a.dropdown-item(href='javascript:void(0)')
                i.svg-icon.mr-2.ml-1(data-feather='credit-card')
                |                     My Balance
              a.dropdown-item(href='javascript:void(0)')
                i.svg-icon.mr-2.ml-1(data-feather='mail')
                |                     Inbox
              .dropdown-divider
              a.dropdown-item(href='javascript:void(0)')
                i.svg-icon.mr-2.ml-1(data-feather='settings')
                |                     Account Setting
              .dropdown-divider
              a.dropdown-item(href='/admin/logout')
                i.svg-icon.mr-2.ml-1(data-feather='power')
                |                     Logout
              .dropdown-divider
              .pl-4.p-3
                a.btn.btn-sm.btn-info(href='javascript:void(0)') View Profile
          // ==============================================================
          // User profile and search
          // ==============================================================
  // ==============================================================
  // End Topbar header
  // ==============================================================
  // ==============================================================
  // Left Sidebar - style you can find in sidebar.scss
  // ==============================================================
  aside.left-sidebar(data-sidebarbg='skin6')
    // Sidebar scroll
    .scroll-sidebar(data-sidebarbg='skin6')
      // Sidebar navigation
      nav.sidebar-nav
        ul#sidebarnav
          li.sidebar-item
            a.sidebar-link.sidebar-link(href='/admin' aria-expanded='false')
              i.feather-icon(data-feather='home')
              span.hide-menu Dashboard
          li.list-divider
          li.nav-small-cap
            span.hide-menu Chung
          li.sidebar-item
            a.sidebar-link.has-arrow(href='javascript:void(0)' aria-expanded='false')
              i.feather-icon(data-feather='file-text')
              span.hide-menu Ng&#x1B0;&#x1EDD;i d&ugrave;ng
            ul.collapse.first-level.base-level-line(aria-expanded='false')
              li.sidebar-item
                a.sidebar-link(href='/admin/users?role=STAFF')
                  span.hide-menu Nh&acirc;n vi&ecirc;n
              li.sidebar-item
                a.sidebar-link(href='/admin/users?role=CUSTOMER')
                  span.hide-menu Kh&aacute;ch h&agrave;ng
              li.sidebar-item
                a.sidebar-link(href='/admin/users/add')
                  span.hide-menu Thêm người dùng 
          li.sidebar-item
            a.sidebar-link.has-arrow(href='javascript:void(0)' aria-expanded='false')
              i.feather-icon(data-feather='grid')
              span.hide-menu Qu&#x1EA3;n l&yacute; tuy&#x1EBF;n xe
            ul.collapse.first-level.base-level-line(aria-expanded='false')
              li.sidebar-item
                a.sidebar-link(href='/admin/bus-routes')
                  span.hide-menu Danh s&aacute;ch tuy&#x1EBF;n xe
              li.sidebar-item
                a.sidebar-link(href='/admin/add-bus-route')
                  span.hide-menu Th&ecirc;m tuy&#x1EBF;n xe
          li.sidebar-item
            a.sidebar-link.has-arrow(href='javascript:void(0)' aria-expanded='false')
              i.feather-icon(data-feather='bar-chart')
              span.hide-menu Qu&#x1EA3;n l&yacute; chuy&#x1EBF;n xe
            ul.collapse.first-level.base-level-line(aria-expanded='false')
              li.sidebar-item
                a.sidebar-link(href='/admin/trips')
                  span.hide-menu Danh s&aacute;ch chuy&#x1EBF;n xe
              li.sidebar-item
                a.sidebar-link(href='/admin/add-trip')
                  span.hide-menu Th&ecirc;m chuy&#x1EBF;n xe
          li.sidebar-item
            a.sidebar-link.has-arrow(href='javascript:void(0)' aria-expanded='false')
              i.feather-icon(data-feather='box')
              span.hide-menu Qu&#x1EA3;n l&yacute; xe
            ul.collapse.first-level.base-level-line(aria-expanded='false')
              li.sidebar-item
                a.sidebar-link(href='/admin/buses')
                  span.hide-menu Danh s&aacute;ch xe
          li.sidebar-item
            a.sidebar-link.has-arrow(href='javascript:void(0)' aria-expanded='false')
              i.feather-icon(data-feather='box')
              span.hide-menu Qu&#x1EA3;n l&yacute; ho&aacute; &dstrok;&#x1A1;n
            ul.collapse.first-level.base-level-line(aria-expanded='false')
              li.sidebar-item
                a.sidebar-link(href='invoice.html')
                  span.hide-menu Danh s&aacute;ch ho&aacute; &dstrok;&#x1A1;n
          li.sidebar-item
            a.sidebar-link.has-arrow(href='javascript:void(0)' aria-expanded='false')
              i.feather-icon(data-feather='box')
              span.hide-menu Th&#x1ED1;ng k&ecirc;
            ul.collapse.first-level.base-level-line(aria-expanded='false')
              li.sidebar-item
                a.sidebar-link(href='/admin/statistics')
                  span.hide-menu Th&#x1ED1;ng k&ecirc;
      // End Sidebar navigation
    // End Sidebar scroll
  // ==============================================================
  // End Left Sidebar - style you can find in sidebar.scss
