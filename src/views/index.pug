  // ==============================================================
  // Page wrapper
  // ==============================================================
  .page-wrapper
    // ==============================================================
    // Bread crumb and right sidebar toggle
    // ==============================================================
    .page-breadcrumb
      .row
        .col-7.align-self-center
          h3.page-title.text-truncate.text-dark.font-weight-medium.mb-1
            | Good Morning Admin!
          .d-flex.align-items-center
            nav(aria-label='breadcrumb')
              ol.breadcrumb.m-0.p-0
                li.breadcrumb-item
                  a(href='/admin') Dashboard
    // ==============================================================
    // End Bread crumb and right sidebar toggle
    // ==============================================================
    // ==============================================================
    // Container fluid
    // ==============================================================
    .container-fluid
      // ***************************************************************
      // Start First Cards
      // ***************************************************************
      .card-group
        .card.border-right
          .card-body
            .d-flex.d-lg-flex.d-md-block.align-items-center
              div
                .d-inline-flex.align-items-center
                  h2.text-dark.mb-1.font-weight-medium #{countCustomer}
                h6.text-muted.font-weight-normal.mb-0.w-100.text-truncate
                  | Kh&aacute;ch h&agrave;ng
              .ml-auto.mt-md-3.mt-lg-0
                span.opacity-7.text-muted
                  i(data-feather='user-plus')
        .card.border-right
          .card-body
            .d-flex.d-lg-flex.d-md-block.align-items-center
              div
                h2.text-dark.mb-1.w-100.text-truncate.font-weight-medium
                  | #{countTrip}
                h6.text-muted.font-weight-normal.mb-0.w-100.text-truncate
                  | S&#x1ED1; chuy&#x1EBF;n xe
              .ml-auto.mt-md-3.mt-lg-0
                span.opacity-7.text-muted
                  i(data-feather='dollar-sign')
        .card.border-right
          .card-body
            .d-flex.d-lg-flex.d-md-block.align-items-center
              div
                .d-inline-flex.align-items-center
                  h2.text-dark.mb-1.font-weight-medium
                    | 1.000.000 VND
                h6.text-muted.font-weight-normal.mb-0.w-100.text-truncate
                  | T&#x1ED5;ng doanh thu trong th&aacute;ng
              .ml-auto.mt-md-3.mt-lg-0
                span.opacity-7.text-muted
                  i(data-feather='file-plus')
    // ==============================================================
    // End Container fluid
    // ==============================================================
    // ==============================================================
    // footer
    // ==============================================================
    footer.footer.text-center.text-muted
      | All Rights Reserved by Poly Team.
    // ==============================================================
    // End footer
